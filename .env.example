# Clerk (same application as UI — both projects use these keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_KEY_HERE

# UI origin for CORS (Vercel production URL of the frontend project)
FRONTEND_URL=http://localhost:3000

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password-no-spaces
SMTP_FROM="MediBook Clinic <your-email@gmail.com>"

# Daily cron for 1-day-before reminders (Vercel Cron)
CRON_SECRET=your-random-secret-here

# Upstash Redis (Vercel → Storage → Upstash Redis)
KV_REST_API_URL=https://your-upstash-url.upstash.io
KV_REST_API_TOKEN=your-upstash-token
