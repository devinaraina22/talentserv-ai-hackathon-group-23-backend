# Clerk (same application as UI — both projects use these keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_KEY_HERE

# UI origin for CORS (Vercel production URL of the frontend project)
FRONTEND_URL=http://localhost:3000

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password-no-spaces
SMTP_FROM="MediBook Clinic <your-email@gmail.com>"

# Daily cron for 1-day-before reminders (Vercel Cron)
CRON_SECRET=your-random-secret-here

# Comma-separated admin emails — DEPRECATED: use role_assignments in the database
# (Admin → Staff Access page, or seed via npm run db:seed). Kept for reference only.
# ADMIN_EMAILS=devina.raina@talentserv.co.in

# Demo login — role picker UI (staff validated against role_assignments in DB)
DEMO_LOGIN=true

# Postgres — REQUIRED on Vercel (Neon). Leave unset for local file dev only.
# Vercel: Storage → Neon Postgres → DATABASE_URL is added automatically
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
